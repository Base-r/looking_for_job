# Скопируйте в .env и заполните своими значениями (см. НАЧАЛО_РАБОТЫ.md).
# .env не попадает в git (.gitignore). Ключ — только сюда, не в код и не в CLI.

SNE_AI_BASE_URL=https://api.deepseek.com/v1

# Название модели — скопируйте точное имя со страницы моделей/цен провайдера.
SNE_AI_MODEL=deepseek-flash

# Секретный ключ API.
SNE_AI_API_KEY=sk-your-key

# Необязательно: отдельная (например, более сильная) модель для писем.
# Пусто — письма пишет та же модель, что оценивает вакансии.
# SNE_AI_LETTER_MODEL=deepseek-flash
